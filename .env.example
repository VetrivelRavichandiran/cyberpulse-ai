# ── CYBERPULSE AI — environment configuration ─────────────────────────────
# Copy to `.env` and adjust. Never commit real secrets.

# ── Database ───────────────────────────────────────────────────────────────
# SQLite (default, zero-dependency demo):
DATABASE_URL=sqlite:///./data/demo/cyberpulse.db
# PostgreSQL + PostGIS (production / docker compose):
# DATABASE_URL=postgresql+psycopg2://cyberpulse:cyberpulse@localhost:5432/cyberpulse
POSTGRES_USER=cyberpulse
POSTGRES_PASSWORD=cyberpulse
POSTGRES_DB=cyberpulse

# ── Neo4j (optional — PostgreSQL graph fallback is used when absent) ──────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=cyberpulse_neo4j

# ── Redis (optional — in-process pub/sub is used when absent) ──────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-0123456789abcdef
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── ML ─────────────────────────────────────────────────────────────────────
MODEL_PATH=ml/artifacts/model_v1.joblib
MODEL_REGISTRY_PATH=ml/artifacts/model_registry.json

# ── Risk engine ────────────────────────────────────────────────────────────
# Risk = ML probability (anchor) + RISK_BOOST_FACTOR * contextual signals.
# Contextual weights (anomaly/graph/temporal/history) are normalized to sum 1.
RISK_BOOST_FACTOR=0.20
RISK_WEIGHT_ANOMALY=0.35
RISK_WEIGHT_GRAPH=0.25
RISK_WEIGHT_TEMPORAL=0.25
RISK_WEIGHT_HISTORY=0.15
RISK_ALERT_THRESHOLD=60

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── API ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000